# =====================================================
# BROski Void Video Agent — keys & settings
# Copy to .env and fill in. NEVER commit .env!
# =====================================================

# ==== ONE KEY FOR ALL CLOUD MODELS ==================
# Seedance / Veo / Kling / PixVerse / Vidu / Wan cloud
# https://muapi.ai
MUAPI_KEY=
MUAPI_BASE_URL=https://api.muapi.ai/v1

# ==== YOUR EXISTING HEYGEN SETUP =====================
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ==== FREE LOCAL LANE (optional, needs GPU) =========
COMFYUI_URL=http://comfyui:8188
WAN_WORKFLOW_PATH=polish/comfyui-workflows/wan22-t2v.json
WAN_PROMPT_NODE=6

# ==== V2 PIPELINE =====================================
DEFAULT_MODE=CHEAP      # FREE | CHEAP | QUALITY | PRO
OUTPUT_DIR=/app/output
STYLE_PRESETS_PATH=config/style-presets.json

# =====================================================
# 🧠 V3 CREW (crew/ — see crew/README.md)
# =====================================================

# ==== THE CRITIC (any OpenAI-compatible VLM) ========
# OpenRouter:  CRITIC_BASE_URL=https://openrouter.ai/api/v1  + CRITIC_API_KEY
# Ollama local: CRITIC_BASE_URL=http://localhost:11434/v1  (no key needed)  + CRITIC_MODEL=llava
CRITIC_BASE_URL=
CRITIC_API_KEY=
CRITIC_MODEL=google/gemini-2.0-flash-001
CRITIC_MOCK=1           # set 0 to use a real VLM (1 = offline mock mode, £0)

# ==== CREW GUARDRAILS ================================
MAX_COST_GBP=2.00       # hard £ cap per run — checked before EVERY generation
MAX_RETRIES_PER_SHOT=3  # no infinite reject loops
ACCEPT_SCORE=7.0        # critic score (0-10) that marks a shot accepted
RUNS_DIR=runs           # folder-first production state
CHARACTER_DIR=config/characters
