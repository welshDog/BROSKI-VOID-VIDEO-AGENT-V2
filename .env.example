# =====================================================
# BROski Void Video Agent — keys & settings
# Copy to .env and fill in. NEVER commit .env!
# =====================================================

# ==== ONE KEY FOR ALL CLOUD MODELS ==================
MUAPI_KEY=
MUAPI_BASE_URL=https://api.muapi.ai/v1

# ==== YOUR EXISTING HEYGEN SETUP =====================
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ==== FREE LOCAL LANE (optional, needs GPU) =========
COMFYUI_URL=http://comfyui:8188
WAN_WORKFLOW_PATH=polish/comfyui-workflows/wan22-t2v.json
WAN_PROMPT_NODE=6

# ==== V2 PIPELINE =====================================
DEFAULT_MODE=CHEAP
OUTPUT_DIR=/app/output
STYLE_PRESETS_PATH=config/style-presets.json

# =====================================================
# 🧠 V3 CREW
# =====================================================

# Critic VLM (OpenRouter or Ollama)
CRITIC_BASE_URL=
CRITIC_API_KEY=
CRITIC_MODEL=google/gemini-2.0-flash-001
CRITIC_MOCK=1

# Director LLM (falls back to CRITIC_* then regex)
DIRECTOR_BASE_URL=
DIRECTOR_API_KEY=
DIRECTOR_MODEL=
DIRECTOR_MOCK=1

# Guardrails — enforced in the core loop
MAX_COST_GBP=2.00
MAX_RETRIES_PER_SHOT=3
ACCEPT_SCORE=7.0
RUNS_DIR=runs
CHARACTER_DIR=config/characters
